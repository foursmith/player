#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export CGO_ENABLED="${CGO_ENABLED:-0}"
export GOFLAGS="${GOFLAGS:-} -buildvcs=false"
if [[ "$(go env GOOS)/$(go env GOARCH)" == darwin/arm64 && -z "${FSVR_NATIVE_LIB_DIR:-}" && -f .cache/tflite/libtensorflowlite_c.2.17.1.dylib ]]; then
    export FSVR_TFLITE_LIBRARY="${FSVR_TFLITE_LIBRARY:-$PWD/.cache/tflite/libtensorflowlite_c.2.17.1.dylib}"
fi
exec "$@"
